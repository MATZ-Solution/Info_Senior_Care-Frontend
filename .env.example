# Base URL of the InfoSenior Care backend (FastAPI/uvicorn).
# The chat WebSocket is derived from this by swapping http(s) -> ws(s).
VITE_API_BASE_URL=http://localhost:8000

# Supabase project -- used ONLY for the OAuth redirect handshake (Google/Apple
# sign-in) directly from the browser via the Supabase SDK. Email/password auth
# and everything else still goes through the FastAPI backend above. The anon
# key is safe to expose client-side (same one Supabase's own JS SDK expects).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
